# Fast path: reuse an existing microphone-enabled PulseAudio build.
ARG PULSE_IMAGE=localhost/baseimage-gui:ubuntu-26.04-microphone-poc
ARG UBUNTU_BASE=docker.io/jlesage/baseimage-gui:ubuntu-26.04-v4
ARG FIREFOX_BASE=ubuntu-runtime
ARG MICROPHONE_BUILD_IMAGE=docker.io/library/alpine:3.20

FROM --platform=$BUILDPLATFORM docker.io/tonistiigi/xx AS xx

FROM --platform=$BUILDPLATFORM docker.io/library/alpine:3.20 AS certificates

FROM ${PULSE_IMAGE} AS microphone-pulse

# Match the production BUILDPLATFORM toolchain and TARGETPLATFORM sysroot.
FROM --platform=$BUILDPLATFORM ${MICROPHONE_BUILD_IMAGE} AS microphone-build
ARG TARGETPLATFORM
COPY --from=xx / /
COPY src/microphone/build.sh /tmp/build-microphone/build.sh
RUN /tmp/build-microphone/build.sh libraries
COPY src/microphone /tmp/build-microphone
# Reused compiler images can carry xx configs selecting ld by an absolute path,
# which Clang 17 rejects with -Werror. Regenerate these for the installed lld.
RUN rm -f /etc/llvm/xx-default.cfg "/usr/bin/$(xx-info triple).cfg" && \
    XX_CC_PREFER_LINKER=lld xx-clang --setup-target-triple && \
    /tmp/build-microphone/build.sh binary

FROM ${UBUNTU_BASE} AS ubuntu-runtime
COPY --from=microphone-pulse /opt/base/bin/pulseaudio /opt/base/bin/pulseaudio
COPY --from=microphone-build /tmp/build-microphone/microphone /opt/base/bin/microphone
ENV WEB_MICROPHONE=0
LABEL org.opencontainers.image.description="Ubuntu GUI development image with browser microphone redirection"

# make build-source passes its completed runtime as FIREFOX_BASE, bypassing the
# fast-path stages above. Both paths install the same browser and launch helpers.
FROM ${FIREFOX_BASE} AS firefox
# The minimal Ubuntu base has no CA bundle. Bootstrap HTTPS before apt installs
# Ubuntu's own ca-certificates package; this also works with FIREFOX_BASE.
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Standalone Firefox avoids Ubuntu's Snap browser packages.
RUN set -eu; \
    if [ "$(dpkg --print-architecture)" != amd64 ]; then \
        echo 'This Firefox test image currently supports linux/amd64 only.' >&2; \
        exit 1; \
    fi; \
    if ! getent group messagebus >/dev/null; then groupadd --system messagebus; fi; \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' \
        /etc/apt/sources.list.d/ubuntu.sources; \
    printf 'Acquire::Retries "3";\n' > /etc/apt/apt.conf.d/80mic-test-retries; \
    add-pkg ca-certificates curl xz-utils libgtk-3-0t64 libasound2t64 libdbus-glib-1-2 libpulse0

ARG FIREFOX_VERSION=158.0
RUN set -eu; \
    if [ -x /opt/firefox/firefox ] && \
       [ "$(/opt/firefox/firefox --version)" = "Mozilla Firefox ${FIREFOX_VERSION}" ]; then \
        echo "Using installed Firefox ${FIREFOX_VERSION}"; \
        exit 0; \
    fi; \
    curl --fail --location --retry 3 \
        "https://archive.mozilla.org/pub/firefox/releases/${FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${FIREFOX_VERSION}.tar.xz" \
        --output /tmp/firefox.tar.xz; \
    mkdir -p /opt/firefox; \
    tar --no-same-owner -xJf /tmp/firefox.tar.xz --strip-components=1 -C /opt/firefox; \
    rm /tmp/firefox.tar.xz; \
    /opt/firefox/firefox --version

# Keep browser downloads cached when only UI or runtime files change.
COPY rootfs/ /
COPY mic-test/up-br /usr/local/bin/up-br
COPY mic-test/startapp-test.sh /startapp.sh
RUN chmod 755 /usr/local/bin/up-br /startapp.sh
